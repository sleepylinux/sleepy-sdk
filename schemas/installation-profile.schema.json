{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleepy-linux.org/schemas/v1/installation-profile.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "machine", "firstBoot", "rollback"],
  "properties": {
    "schemaVersion": { "const": 1 }, "profileId": { "type": "string", "minLength": 1 },
    "machine": { "type": "object", "additionalProperties": false, "required": ["hostName", "system", "desktopEnabled"], "properties": { "hostName": { "type": "string", "minLength": 1 }, "system": { "enum": ["x86_64-linux", "aarch64-linux"] }, "desktopEnabled": { "type": "boolean" } } },
    "firstBoot": { "type": "object", "additionalProperties": false, "required": ["state", "generation"], "properties": { "state": { "enum": ["pending", "applying", "ready", "failed", "rolledBack"] }, "generation": { "type": "integer", "minimum": 1 } } },
    "rollback": { "type": "object", "additionalProperties": false, "required": ["currentGeneration", "availableGenerations"], "properties": { "currentGeneration": { "type": "integer", "minimum": 1 }, "availableGenerations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } } } }
  }
}

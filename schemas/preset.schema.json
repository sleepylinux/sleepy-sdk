{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleepy-linux.org/schemas/v1/preset.schema.json",
  "title": "Sleepy Preset Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "origin",
    "layouts",
    "drawers",
    "keybindings",
    "pluginRequirements"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["builtin", "user"] },
    "basePresetId": { "type": ["string", "null"] },
    "layouts": {
      "type": "object",
      "additionalProperties": true
    },
    "drawers": {
      "type": "object",
      "additionalProperties": true
    },
    "keybindings": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "\\S" },
      "additionalProperties": {
        "type": "string",
        "description": "Syntactic accelerator check only; duplicate modifiers, duplicate chords, known actions, and reserved chords require semantic SDK validation.",
        "pattern": "^\\s*(?:(?:[Mm][Oo][Dd]|[Cc][Tt][Rr][Ll]|[Aa][Ll][Tt]|[Ss][Hh][Ii][Ff][Tt])\\+)*[A-Za-z0-9_]+\\s*$"
      }
    },
    "pluginRequirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "origin": { "const": "builtin" } },
        "required": ["origin"]
      },
      "then": {
        "properties": { "id": { "const": "builtin.sleepy" } }
      }
    },
    {
      "if": {
        "properties": { "origin": { "const": "user" } },
        "required": ["origin"]
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sleepy-linux.org/schemas/v2/provider.schema.json",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "providerId", "kind", "status", "cache"], "properties": { "schemaVersion": { "const": 2 }, "providerId": { "type": "string", "minLength": 1 }, "kind": { "$ref": "#/$defs/kind" }, "status": { "const": "online" }, "cache": { "$ref": "#/$defs/cache" } } },
    { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "providerId", "kind", "status", "cache", "diagnostic"], "properties": { "schemaVersion": { "const": 2 }, "providerId": { "type": "string", "minLength": 1 }, "kind": { "$ref": "#/$defs/kind" }, "status": { "enum": ["offline", "error"] }, "cache": { "$ref": "#/$defs/cache" }, "diagnostic": { "type": "object", "additionalProperties": false, "required": ["message"], "properties": { "message": { "type": "string", "minLength": 1 } } } } }
  ],
  "$defs": { "kind": { "enum": ["calendar", "weather", "geocoding", "secret"] }, "cache": { "enum": ["fresh", "stale", "missing"] } }
}
